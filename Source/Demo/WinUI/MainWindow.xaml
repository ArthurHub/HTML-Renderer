<Window
    x:Class="TheArtOfDev.HtmlRenderer.Demo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TheArtOfDev.HtmlRenderer.Demo.WinUI">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar x:Name="_toolBar" Grid.Row="0" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Icon="NewWindow" Label="Open Sample Window" Click="OnOpenSampleWindow_Click"/>
            <AppBarSeparator/>
            <AppBarToggleButton x:Name="_showBrowserView" Icon="Globe" Label="Show Browser" Click="OnShowBrowserView_Click"/>
            <AppBarButton Icon="OpenWith" Label="Open External" Click="OnOpenExternal_Click"/>
            <AppBarToggleButton x:Name="_useGeneratedHtml" Label="Generated HTML" Click="OnUseGeneratedHtml_Click"
                                ToolTipService.ToolTip="Use the HTML generated by the renderer for the browser, external view, image and PDF">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE943;"/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator/>
            <AppBarButton Icon="Pictures" Label="Generate Image" Click="OnGenerateImage_Click"/>
            <AppBarButton Icon="Document" Label="Generate PDF" Click="OnGeneratePdf_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Clock" Label="Run Performance" Click="OnRunPerformance_Click"/>
        </CommandBar>
        <local:MainControl x:Name="_mainControl" Grid.Row="1" Margin="4"/>
    </Grid>
</Window>
