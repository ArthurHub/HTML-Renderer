<Project>
  <PropertyGroup>
    <Product>HTML Renderer</Product>
    <Authors>Arthur Teplitzki</Authors>
    <Owners>Arthur Teplitzki</Owners>
    <Company>Open source hosted on GitHub</Company>
    <Copyright>Copyright © 2008-2026</Copyright>
    <Version>2.0.0-dev</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArthurHub/HTML-Renderer</PackageProjectUrl>
    <PackageIcon>html.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>See https://github.com/ArthurHub/HTML-Renderer/releases.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <!-- A strong-named .NET Framework assembly can only reference strong-named assemblies. The key isn't a secret,
       strong names aren't a security feature. Keep AssemblyVersion at 2.0.0.0 for all of 2.x, any change of it
       breaks the binding of strong-named references on .NET Framework. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)HtmlRenderer.snk</AssemblyOriginatorKeyFile>
    <!-- Used for every InternalsVisibleTo without a Key -->
    <PublicKey></PublicKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <None Include="../../html.png" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
