<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>TheArtOfDev.HtmlRenderer</RootNamespace>
	<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- NuGet Package Properties -->
  <PropertyGroup>
    <PackageId>HtmlRenderer.Core</PackageId>
    <Title>HTML Renderer Core</Title>
    <PackageTags>html render renderer draw core</PackageTags>
    <Description>Cross framework (WinForms/WPF/PDF/Metro/etc.), Multipurpose (UI Controls / Image generation / PDF generation / etc.), 100% managed (C#), High performance HTML Rendering library.

The Core assembly of HTML Renderer does not bound to any rendering framework (WinForms/WPF/PDF/etc.).
Can be used to create framework specific renderer using adapter extensibility object model.
For existing implementations see: HtmlRenderer.WinForms, HtmlRenderer.WPF and HtmlRenderer.PdfSharp.</Description>
    <Summary>Cross framework (WinForms/WPF/PDF/Metro/etc.), Multipurpose (UI Controls / Image generation / PDF generation / etc.), 100% managed (C#), High performance HTML Rendering library.</Summary>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Core\Utils\ImageError.png" />
    <EmbeddedResource Include="Core\Utils\ImageLoad.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HtmlRenderer.Test" />
    <InternalsVisibleTo Include="HtmlRenderer.IntegrationTest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Grants the WinForms/WPF/PdfSharp adapters access to internal members: originally just
         RAdapter.SystemColorSchemeOverride (a test-only seam that makes prefers-color-scheme
         rendering deterministic regardless of the host machine's own theme setting), now also
         HtmlContainerInt.FragmentTree and its FragmentainerFragment-based PerformPaint overload -
         the fragment tree stays internal rather than becoming public API while this port is still
         underway. The image-regression test assembly also needs this (it sets the color-scheme
         override and reaches deep into layout/fragment internals for precision assertions). -->
    <InternalsVisibleTo Include="HtmlRenderer.WinForms" />
    <InternalsVisibleTo Include="HtmlRenderer.WPF" />
    <InternalsVisibleTo Include="HtmlRenderer.PdfSharp" />
    <InternalsVisibleTo Include="HtmlRenderer.IntegrationTest" />
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="System.Resources.Extensions" Version="10.0.10" />
	<PackageReference Include="HtmlKit" Version="1.2.0" />
  </ItemGroup>
</Project>